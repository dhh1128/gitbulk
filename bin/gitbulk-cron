#!/usr/bin/env bash
# Cron-friendly wrapper around `gitbulk`.
#
# Captures all output to a timestamped log under ~/.cache/gitbulk/cron/.
# Exit-code-aware symlinks (this.i node clip7nm4):
#   exit 0       no symlink (clean run, nothing to flag)
#   exit 1       last-failure.log     structural failure
#   exit 2 or 3  last-attention.log   PRs need attention / repos skipped
#   exit 4       last-audit.log       override audit signal
#   exit 99      no symlink (subcommand not yet implemented)
#
# Cron-overlap protection: an outer flock prevents two simultaneous
# invocations of this wrapper from racing. The tool's internal lock
# (locks.py) handles intra-tool concurrency; this is just a fast-fail
# shortcut so the second cron firing doesn't pile up waiting.
#
# Log retention: cron logs older than $RETAIN_DAYS days are removed at the
# end of every successful invocation. Default 30; override with the env var.
#
# PATH: cron's minimal PATH typically lacks ~/.local/bin or any venv. We
# either source a venv (if VENV is set), use GITBULK_BIN (absolute path
# to the gitbulk binary), or prepend a known-good PATH so a pip-installed
# `gitbulk` is discoverable. Configure ONE of these in the crontab line.
#
# Usage from crontab:
#   0 3 * * * /home/you/code/gitbulk/bin/gitbulk-cron report
#   # or with explicit binary:
#   0 3 * * * GITBULK_BIN=/home/you/venvs/gitbulk/bin/gitbulk \
#               /home/you/code/gitbulk/bin/gitbulk-cron report
#
set -eo pipefail
set -u

# ─── Configuration with sensible defaults ───────────────────────────────────

CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/gitbulk"
LOG_DIR="${CACHE_DIR}/cron"
LOCK_FILE="${CACHE_DIR}/cron.lock"
RETAIN_DAYS="${GITBULK_CRON_RETAIN_DAYS:-30}"

# Never advertise (or attempt) a self-update from cron: a nightly notice is
# log noise and replacing the binary underneath a running job is unsafe.
# The CLI already TTY-gates the notice (this.i node updnc5kr); this is the
# belt-and-suspenders that keeps it off even if cron ever attaches a TTY.
export GITBULK_NO_UPDATE_CHECK=1

# Resolve the gitbulk binary. Priority:
#   1. GITBULK_BIN explicit absolute path
#   2. gitbulk found on PATH after prepending ~/.local/bin
#   3. error and exit 1
if [ -n "${GITBULK_BIN:-}" ]; then
    GITBULK="${GITBULK_BIN}"
elif [ -n "${VIRTUAL_ENV:-}" ] && [ -x "${VIRTUAL_ENV}/bin/gitbulk" ]; then
    GITBULK="${VIRTUAL_ENV}/bin/gitbulk"
else
    export PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"
    if ! command -v gitbulk >/dev/null 2>&1; then
        echo "gitbulk-cron: cannot find gitbulk on PATH; set GITBULK_BIN or VIRTUAL_ENV" >&2
        exit 1
    fi
    GITBULK="$(command -v gitbulk)"
fi

mkdir -p "${LOG_DIR}"

TS=$(date -u +%Y%m%dT%H%M%SZ)
SUBCMD="${1:-report}"
LOG="${LOG_DIR}/${TS}-${SUBCMD}.log"

# ─── Outer flock so two cron firings don't pile up ──────────────────────────

# Acquire a non-blocking exclusive lock; if held, the previous run is still
# going — bail out fast rather than queue up another waiter.
exec 200>"${LOCK_FILE}"
if ! flock -n 200; then
    echo "gitbulk-cron: previous run still in progress (lock held on ${LOCK_FILE}); skipping this firing" >&2
    exit 0
fi

# ─── Env preamble so each log is self-describing for debugging ──────────────

# Written with `>` to create/truncate the log; the gitbulk output below is
# appended with `>>`. This block must never abort the run under `set -e`
# (e.g. an optional `gh` probe failing), so each line that could fail is
# guarded with `|| true` and gh is gated behind a fast, network-free check.
{
    echo "--- gitbulk-cron preamble ---"
    echo "started_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "gitbulk_bin: ${GITBULK}"
    echo "subcommand:  ${SUBCMD}"
    echo "argv:        $*"
    echo "path:        ${PATH}"
    # gh account is best-effort only: never block, never hit the network, and
    # never fail the run. We only read an already-cached active account from
    # `gh auth status` (which is local) and time-box it; on any error we skip.
    if command -v gh >/dev/null 2>&1; then
        gh_line="$(timeout 3 gh auth status 2>/dev/null | head -n 1 || true)"
        [ -n "${gh_line}" ] && echo "gh_account:  ${gh_line}" || true
    fi
    echo "--- end gitbulk-cron preamble ---"
    echo
} >"${LOG}" 2>&1 || true

# ─── Run the actual command, captured to the log ────────────────────────────

# `set -e` would abort on the gitbulk failure before we can branch on rc;
# disable it just for this call. Output is APPENDED after the preamble.
set +e
"${GITBULK}" "$@" >>"${LOG}" 2>&1
rc=$?
set -e

# ─── Exit-code-aware symlinks ───────────────────────────────────────────────

case "${rc}" in
    0)   ;;
    1)   ln -sf "${LOG}" "${LOG_DIR}/last-failure.log"   ;;
    2|3) ln -sf "${LOG}" "${LOG_DIR}/last-attention.log" ;;
    4)   ln -sf "${LOG}" "${LOG_DIR}/last-audit.log"     ;;
    99)  ;;  # subcommand not yet implemented; not a failure
    *)   ln -sf "${LOG}" "${LOG_DIR}/last-failure.log"   ;;
esac

# ─── Cron-log retention sweep ───────────────────────────────────────────────

# Prune timestamped logs older than RETAIN_DAYS. The named symlinks
# (last-failure.log, last-attention.log, last-audit.log) are left alone;
# they regenerate naturally on the next run.
find "${LOG_DIR}" -maxdepth 1 -type f -name '*.log' -mtime "+${RETAIN_DAYS}" -delete 2>/dev/null || true

# ─── One-line MAILTO-friendly status ────────────────────────────────────────

STATUS="gitbulk-cron: ${SUBCMD} exit=${rc} log=${LOG}"

# Always record the status at the end of the log so the log is self-describing
# and states the exit code explicitly. The `>>` append must not abort the run
# under `set -e`, hence `|| true`.
echo "${STATUS}" >>"${LOG}" 2>&1 || true

# Emit to stdout ONLY for structural failures and unexpected codes. cron mails
# whatever a job writes to stdout, so this makes MAILTO a failure-only channel:
# silent on clean runs (0), routine attention/skips (2|3) — which fire ~nightly
# for a large fleet — audit-only (4), and not-implemented (99). An always-on
# echo would also mail the bare local user (recipient '<daniel>', 553-rejected)
# whenever MAILTO is unset. Policy node tp4kq2nr; surfaced by the live cron
# shakedown (node shkd5crn) 2026-05-29. The email set matches the
# last-failure.log symlink set above (exit 1 + catch-all).
case "${rc}" in
    0|2|3|4|99) ;;                  # quiet on stdout: no cron email
    *)          echo "${STATUS}" ;; # exit 1 and unexpected -> stdout -> email
esac

exit ${rc}
