#!/usr/bin/env sh
set -eu

# Skip certification check when the developer declares no AI was used.
# Usage: AGENTPREP_NO_AI=1 git commit ...
if [ "${AGENTPREP_NO_AI:-0}" = "1" ]; then
  exit 0
fi

if command -v agentprep >/dev/null 2>&1; then
  AGENTPREP_CMD="agentprep"
elif [ -f agentprep.py ]; then
  AGENTPREP_CMD="python3 agentprep.py"
else
  echo "agentprep not found — install it or keep agentprep.py in the repo root." >&2
  exit 127
fi

# When AGENTPREP_AGENT is set, pass it so verify also checks that the human
# certified this specific AI tool — not just that any valid cert exists.
_AP_FAIL=0
if [ -n "${AGENTPREP_AGENT:-}" ]; then
  $AGENTPREP_CMD verify --agent "$AGENTPREP_AGENT" >/dev/null || _AP_FAIL=1
else
  $AGENTPREP_CMD verify >/dev/null || _AP_FAIL=1
fi
if [ "$_AP_FAIL" = "1" ]; then
  printf '\nThis repository requires AI use certification before committing.\n' >&2
  printf 'Fix: agentprep certify\n' >&2
  printf '     export AGENTPREP_AGENT=<tool>  (e.g. claude, gemini, copilot)\n' >&2
  printf 'If no AI was used for this commit: AGENTPREP_NO_AI=1 git commit ...\n\n' >&2
  exit 1
fi
unset _AP_FAIL

# Chain to other pre-commit hooks that may be installed in this repository.
# Execute directly (respecting the hook's shebang) rather than forcing sh,
# so Node-based hooks (Husky, etc.) run correctly.
for _AP_HOOK in ".husky/pre-commit" ".lefthook/pre-commit"; do
  if [ -x "$_AP_HOOK" ]; then
    "$_AP_HOOK"
    break
  elif [ -f "$_AP_HOOK" ]; then
    sh "$_AP_HOOK"
    break
  fi
done
unset _AP_HOOK
