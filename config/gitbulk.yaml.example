# gitbulk policy and classification config.
# Copy to ~/.config/gitbulk/gitbulk.yaml and edit. Every value below is
# optional; missing keys fall back to the documented defaults from
# `this.i`. Unknown keys are rejected loudly — typos like
# `min_buisness_days` will fail validation rather than silently no-op.

defaults:
  merge_policy: strict           # strict | ci-only | never
  merge_method: rebase           # rebase | merge | squash — method passed to `gh pr merge`
  min_business_days: 3           # business days (M-F local TZ) since "ready"
  unresolved_burden: me          # me | other | either — who marks threads resolved
  bot_threads_block: true        # if true, unresolved bot threads also block "ready"
  stale_age_days: 90             # close-stale: inactivity threshold
  stale_cooloff_days: 7          # close-stale: must have been warned at least this long ago
  stale_policy: warn-and-close   # warn-and-close | warn-only | never
  prune_min_age_days: 7          # prune-branches/-worktrees: grace period since a PR merged/closed
  # sacred_branches: []          # prune-branches/-worktrees: extra branch names NEVER
  #                              # auto-pruned (local OR remote), alongside the always-sacred
  #                              # main/master, gh-pages/tick (orphan-branch conventions),
  #                              # and each repo's GitHub default branch (e.g. [develop, trunk]).
  #                              # Exact, case-sensitive match. prune-worktrees additionally
  #                              # never harvests any branch with no shared history with the
  #                              # default (an orphan branch), regardless of its name.
  # skip_checks: []              # invariants suppressed for every repo
  # extra_checks: []             # extra invariants enabled for every repo

humans:
  org: provenant-dev             # gitbulk enumerates org members via `gh api orgs/<org>/members`
  cache_ttl_hours: 168           # 7 days; a stale cache auto-refreshes, so a long TTL just avoids needless refetches
  exceptions: []                 # org members that are actually bots
  always_human: []               # extra logins outside the org that should count as human

bots:                            # known non-human accounts; extend as needed
  - github-copilot[bot]
  - copilot-pull-request-reviewer[bot]
  - dependabot[bot]
  - github-actions[bot]
  - renovate[bot]

# Per-repo overrides. Keys are owner/repo strings from repos.txt. Scalar
# fields override the matching `defaults.` value; list fields
# (skip_checks, extra_checks) are APPENDED to the defaults list rather
# than replacing it.
repos: {}
  # provenant-dev/origin-experimental-svc:
  #   merge_policy: ci-only
  #   min_business_days: 1
  # someorg/personal-project:
  #   skip_checks: [repo.agentprep_verified]
  # provenant-dev/origin-platform:
  #   unresolved_burden: other     # acting as maintainer here, not contributor
  # provenant-dev/origin-canonical-history-svc:
  #   merge_method: squash         # this repo wants squash, not the default merge commit

# Disposable worktree root. Defaults to ~/.cache/gitbulk/worktrees/
# (per this.i node mw6kp2nq). Override only if you need a different
# location — e.g., a tmpfs mount.
# worktree_root: ~/.cache/gitbulk/worktrees

# ── Pluggable coding agents (dispatch / summarize) ──────────────────────────
# Which CLI coding agent gitbulk shells out to. Omit everything below to use
# the built-in `claude` default (byte-identical to pre-1.0 behavior). See
# docs/pluggable-agents.md for the full design and the security model.
#
# Built-in presets: claude, gemini, copilot, cursor. Pick one run-wide:
# default_agent: gemini
#
# Per-repo override (under `repos:` above), e.g.:
#   repos:
#     someorg/some-repo:
#       agent: copilot
#
# `--agent NAME` on the command line overrides both.
#
# Override a preset's fields, or define a fully custom agent. SECURITY: every
# `command`/`model_args` is an argv LIST (never a shell string — a string is a
# hard error); `{prompt}` and `{model}` substitute within a single token; the
# binary is pinned via `which` at load. The auto-approve flag in each command
# (--yolo / --allow-all-tools / --dangerously-skip-permissions) is what makes
# unattended runs possible AND removes the in-agent safety net — the sandbox is
# the real boundary.
# agents:
#   gemini:
#     model: gemini-2.5-pro          # override just the model of a preset
#   myagent:                         # a fully custom backend
#     command: [mytool, run, "{prompt}"]   # argv list; exactly one {prompt}
#     model_args: [--model, "{model}"]     # appended only when a model is set
#     model: my-default
#     prompt_via: arg                # arg | stdin  (stdin → no {prompt} token)
#     timeout: 1800
#     env: [MYTOOL_API_KEY]          # allowlist: ONLY these (+ a safe base:
#                                    # PATH/HOME/locale) reach the agent; it
#                                    # does NOT inherit GH_TOKEN/SSH/cloud creds.
#                                    # Omit `env` to inherit everything (the
#                                    # backward-compatible default).
#     sandbox: fs+no-net             # none | fs-only | fs+no-net  (bubblewrap;
#                                    # fs+no-net = no network + creds/other repos
#                                    # hidden. Needs bwrap + unprivileged userns.)

# What to do when a profile requests a sandbox this host can't provide:
#   refuse   (default) — refuse to run rather than silently run unconfined
#   warn-run           — run UNSANDBOXED with a logged warning
# sandbox_fallback: refuse

notifications:
  # Layers 1-4 (file-based) are always-on and require no config here.
  # External adapters (ntfy, slack, etc.) are out of scope for v1.
